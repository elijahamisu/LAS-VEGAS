# SUPABASE CONFIG
# VITE_ values are public client-side values. The service-role key is server-only.
VITE_SUPABASE_URL=https://project-id.supabase.co
VITE_SUPABASE_ANON_KEY=anon-key
SUPABASE_SERVICE_ROLE_KEY=service-role-key

# GLOPAYMENT DEPOSIT CONFIG — set these only in Vercel Project Settings.
# Do not add the signing key to HTML, browser JavaScript, or a VITE_ variable.
GLOPAYMENT_HOST=https://provider-confirmed-api-host
GLOPAYMENT_MERCHANT_ID=your-glopayment-merchant-id
GLOPAYMENT_SIGNING_KEY=your-glopayment-signing-key
GLOPAYMENT_NGN_COLLECTION_CHANNEL_CODE=provider-confirmed-nigeria-collection-channel
# Register this exact public HTTPS URL with GloPayment for deposit callbacks.
GLOPAYMENT_NOTIFY_URL=https://your-domain.vercel.app/api/webhook?type=glopay

# GLOPAYMENT NIGERIA WITHDRAWAL CONFIG
# Use the value shown by “Payment Key”, never “Key collection”.
GLOPAYMENT_PAYMENT_KEY=your-glopayment-payment-key
# Your enabled “Nigeria Category I Payment” channel from the merchant portal.
GLOPAYMENT_NGN_PAYOUT_CHANNEL_CODE=506
GLOPAYMENT_WITHDRAW_NOTIFY_URL=https://your-domain.vercel.app/api/webhook?type=glopay-withdrawal
# The provider documentation leaves the required payout field `number` undefined
# for Nigeria. Ask GloPayment which mode to use; do not choose a value by guesswork.
# Allowed values: account_number, mobile, static
GLOPAYMENT_NGN_PAYOUT_NUMBER_MODE=
# Required only if the confirmed mode is static.
GLOPAYMENT_NGN_PAYOUT_NUMBER=

# OPTIONAL LEGACY NEKPAY CONFIG
# These existing variables are retained only while historical NekPay callbacks or
# NekPay withdrawal functionality remain in use. They are not used for new deposits.
NEKPAYMENT_MCH_ID=
NEKPAYMENT_MERCHANT_KEY=
NEKPAYMENT_WITHDRAW_NOTIFY_URL=https://your-domain.vercel.app/api/webhook?type=withdrawal

# SECURITY
CRON_SECRET=generate-a-random-secure-string
